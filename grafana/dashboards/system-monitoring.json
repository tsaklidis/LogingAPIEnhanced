          "rawQuery": true,
          "rawSql": "SELECT\n  pid,\n  usename AS \"user\",\n  state,\n  EXTRACT(EPOCH FROM (NOW() - query_start))::int AS \"duration\",\n  LEFT(query, 100) AS \"query\"\nFROM pg_stat_activity\nWHERE state != 'idle'\n  AND backend_type = 'client backend'\n  AND pid != pg_backend_pid()\nORDER BY query_start ASC",
