      "title": "Time Between Readings (gap detection)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "sensor-platform-postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH gaps AS (\n  SELECT\n    sensor_id,\n    recorded_at,\n    recorded_at - LAG(recorded_at) OVER (PARTITION BY sensor_id ORDER BY recorded_at) AS gap\n  FROM sensor_readings\n  WHERE $__timeFilter(recorded_at)\n    AND sensor_id IN (\n      '0d42062f-442d-46a5-8c2f-6a27636117f7',\n      'ee4af834-f793-45af-80e8-b7461aac56c8',\n      '5b1a43c4-e114-4a17-b405-f65ed7a09400',\n      'b48e31ee-cb57-4455-9cbc-53cd41e6d1c4'\n    )\n)\nSELECT\n  date_trunc('hour', recorded_at) AS \"time\",\n  EXTRACT(EPOCH FROM AVG(gap)) AS \"avg_gap_seconds\"\nFROM gaps\nWHERE gap IS NOT NULL\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ]
    },
