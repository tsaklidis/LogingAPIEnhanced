      "title": "Container Resources (latest)",
      "type": "table",
      "targets": [
        {
          "rawSql": "SELECT c.metric_name AS \"container\", c.metric_value AS \"cpu_pct\", m.metric_value AS \"mem_mb\", p.metric_value AS \"mem_pct\"\nFROM (SELECT DISTINCT ON (metric_name) metric_name, metric_value FROM system_metrics WHERE metric_type='docker_cpu' ORDER BY metric_name, recorded_at DESC) c\nJOIN (SELECT DISTINCT ON (metric_name) metric_name, metric_value FROM system_metrics WHERE metric_type='docker_mem_mb' ORDER BY metric_name, recorded_at DESC) m ON m.metric_name=c.metric_name\nJOIN (SELECT DISTINCT ON (metric_name) metric_name, metric_value FROM system_metrics WHERE metric_type='docker_mem_pct' ORDER BY metric_name, recorded_at DESC) p ON p.metric_name=c.metric_name\nORDER BY m.metric_value DESC",
          "format": "table",
          "rawQuery": true,
          "refId": "A"
        }
      ]
