          "rawSql": "SELECT\n  date_trunc('hour', sr.recorded_at) AS \"time\",\n  s.name AS \"metric\",\n  COUNT(*) AS \"value\"\nFROM sensor_readings sr\nJOIN sensors s ON s.id = sr.sensor_id\nWHERE $__timeFilter(sr.recorded_at)\nGROUP BY 1, 2\nORDER BY 1",
