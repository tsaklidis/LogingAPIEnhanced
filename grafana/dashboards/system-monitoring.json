      "title": "Sensor Health — Last Activity",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "sensor-platform-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  s.name,\n  s.sensor_type,\n  s.is_active,\n  MAX(sr.recorded_at) AS \"last_reading\",\n  EXTRACT(EPOCH FROM (NOW() - MAX(sr.recorded_at)))::int AS \"age_seconds\",\n  COUNT(sr.id) FILTER (WHERE sr.recorded_at >= NOW() - INTERVAL '24 hours') AS \"readings_24h\"\nFROM sensors s\nLEFT JOIN sensor_readings sr ON sr.sensor_id = s.id\nGROUP BY s.id, s.name, s.sensor_type, s.is_active\nORDER BY \"last_reading\" DESC NULLS LAST",
          "refId": "A"
        }
      ]
    },
