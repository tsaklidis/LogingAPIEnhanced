      "title": "Table Sizes & Row Counts",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "sensor-platform-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  schemaname || '.' || relname AS \"table\",\n  pg_total_relation_size(relid) AS \"size\",\n  n_live_tup AS \"live_rows\",\n  n_dead_tup AS \"dead_rows\",\n  COALESCE(last_vacuum, last_autovacuum) AS \"last_vacuum\",\n  COALESCE(last_analyze, last_autoanalyze) AS \"last_analyze\"\nFROM pg_stat_user_tables\nORDER BY pg_total_relation_size(relid) DESC",
          "refId": "A"
