apiVersion: 1

# Copy this file to datasources.yaml and fill in your values.
# datasources.yaml is in .gitignore — never commit actual passwords.

datasources:
  - name: Sensor Platform PostgreSQL
    uid: sensor-platform-postgres
    type: postgres
    url: db:5432
    database: sensor_platform
    user: ${POSTGRES_USER:-postgres}
    secureJsonData:
      password: "${POSTGRES_PASSWORD}"
    jsonData:
      sslmode: disable
      maxOpenConns: 10
      maxIdleConns: 2
      connMaxLifetime: 14400
      postgresVersion: 1600
      timescaledb: false
    access: proxy
    isDefault: true
    editable: true

