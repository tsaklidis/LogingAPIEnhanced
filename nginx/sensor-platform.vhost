upstream sensor_platform {
    server 127.0.0.1:8080;
}

server {
    listen 80;
    server_name logs.tsaklidis.gr;

    client_max_body_size 10M;

    location / {
        proxy_pass http://sensor_platform;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10;
        proxy_read_timeout 30;
    }

    # deny access to dot files
    location ~ /\. {
        deny all;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/logs.tsaklidis.gr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/logs.tsaklidis.gr/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = logs.tsaklidis.gr) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    server_name logs.tsaklidis.gr;
    return 404;
}

